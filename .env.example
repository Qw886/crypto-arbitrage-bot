# Optional non-sensitive overrides. No live mode or credentials are supported.
CAB_POLL_INTERVAL_SECONDS=10
CAB_LOG_LEVEL=INFO
CAB_LOG_DIR=logs
# Fictional research fee assumptions, decimal fractions, not Binance account fees.
CAB_FEES__SPOT_ENTRY=0.001
CAB_FEES__SPOT_EXIT=0.002
CAB_FEES__PERP_ENTRY=0.0005
CAB_FEES__PERP_EXIT=0.0008
